<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Allow existing files and directories to be accessed directly (CSS, JS, images, fonts, uploads)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Redirect external requests with .php to clean URL (without .php)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ %1 [R=301,L]

# 3. Rewrite extensionless clean URLs internally to corresponding .php file
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]
</IfModule>
