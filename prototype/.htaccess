<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /gsgwebsoft/schoolerp/prototype/

# 1. Redirect /index.php or /index to / (clean root)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(?:gsgwebsoft/schoolerp/prototype/)?index(?:\.php)?[\s?] [NC]
RewriteRule ^ /gsgwebsoft/schoolerp/prototype/ [R=301,L]

# 2. Redirect external requests with .php to clean URL (without .php)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(?:gsgwebsoft/schoolerp/prototype/)?([^.\s?]+)\.php[\s?] [NC]
RewriteRule ^ /gsgwebsoft/schoolerp/prototype/%1 [R=301,L]

# 3. Allow existing files and directories to be accessed directly (CSS, JS, images, fonts)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4. Rewrite extensionless clean URLs internally to corresponding .php file
RewriteCond %{DOCUMENT_ROOT}/gsgwebsoft/schoolerp/prototype/$1.php -f [OR]
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]
</IfModule>
